{
	admin off
	auto_https off
}

:8441 {
	bind 127.0.0.1
	@reads {
		method GET HEAD
		path_regexp ^/v4/(catalog|tracks/[a-zA-Z0-9_-]+/audio)$
	}
	handle @reads {
		reverse_proxy https://{$SYNCSTR_BIND_ADDRESS}:{$SYNCSTR_PORT} {
			transport http {
				tls_trust_pool file /etc/syncstr/host.crt
			}
		}
	}
	handle {
		respond 404
	}
}
